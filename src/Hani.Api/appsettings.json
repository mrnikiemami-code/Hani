{
  "ConnectionStrings": {
    "Default": "Host=localhost;Port=5433;Database=hani;Username=hani;Password=hani_dev"
  },
  "Observability": {
    "ServiceName": "Hani.Api",
    "Environment": "Development",
    "Logging": {
      "Enabled": true,
      "MinimumLevel": "Information",
      "Sinks": [ "Console", "Seq" ],
      "SeqUrl": "http://localhost:5342",
      "RedactPii": true
    },
    "Tracing": {
      "Enabled": true,
      "Endpoint": "http://localhost:4317",
      "SamplingRatio": 0.2
    },
    "Metrics": {
      "Enabled": true,
      "Endpoint": "http://localhost:4317"
    }
  },
  "Cache": {
    "Provider": "Memory",
    "DefaultTtlSeconds": 300,
    "Redis": {
      "Configuration": "localhost:6380",
      "InstanceName": "hani:"
    }
  },
  "Messaging": {
    "Transport": "InMemory",
    "RabbitMq": {
      "Host": "rabbitmq://localhost:5673",
      "Username": "hani",
      "Password": "hani_dev"
    },
    "Postgres": {
      "ConnectionString": "Host=localhost;Port=5433;Database=hani;Username=hani;Password=hani_dev"
    },
    "Outbox": {
      "Enabled": false
    }
  },
