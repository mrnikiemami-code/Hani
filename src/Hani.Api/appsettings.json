{
  "ConnectionStrings": {
    "Default": "Host=localhost;Port=5433;Database=hani;Username=hani;Password=hani_dev"
  },
  "Observability": {
    "ServiceName": "Hani.Api",
    "Environment": "Development",
    "Logging": {
      "Enabled": true,
      "MinimumLevel": "Information",
      "Sinks": [ "Console", "Seq" ],
      "SeqUrl": "http://localhost:5342",
      "RedactPii": true
    },
    "Tracing": {
      "Enabled": true,
      "Endpoint": "http://localhost:4317",
      "SamplingRatio": 0.2
    },
    "Metrics": {
      "Enabled": true,
      "Endpoint": "http://localhost:4317"
    }
  },
  "Cache": {
    "Provider": "Memory",
    "DefaultTtlSeconds": 300,
    "Redis": {
      "Configuration": "localhost:6380",
      "InstanceName": "hani:"
    }
  },
  "Messaging": {
    "Transport": "InMemory",
    "RabbitMq": {
      "Host": "rabbitmq://localhost:5673",
      "Username": "hani",
      "Password": "hani_dev"
    },
    "Postgres": {
      "ConnectionString": "Host=localhost;Port=5433;Database=hani;Username=hani;Password=hani_dev"
    },
    "Outbox": {
      "Enabled": false
    }
  },
  "Localization": {
    "DefaultCulture": "fa-IR",
    "SupportedCultures": [ "fa-IR", "en-US", "ar-SA" ],
    "ProblemTitles": {
      "fa": {
        "Validation": "داده‌های ورودی نامعتبر است.",
        "NotFound": "موردی یافت نشد.",
        "Conflict": "وضعیت فعلی اجازه این عملیات را نمی‌دهد.",
        "Unauthorized": "احراز هویت لازم است.",
        "Forbidden": "دسترسی مجاز نیست.",
        "Failure": "خطای غیرمنتظره رخ داد."
      },
      "en": {
        "Validation": "The request is invalid.",
        "NotFound": "The requested item was not found.",
        "Conflict": "The current state does not allow this operation.",
        "Unauthorized": "Authentication is required.",
        "Forbidden": "Access is denied.",
        "Failure": "An unexpected error occurred."
      },
      "ar": {
        "Validation": "البيانات المدخلة غير صالحة.",
        "NotFound": "لم يتم العثور على العنصر المطلوب.",
        "Conflict": "الحالة الحالية لا تسمح بهذه العملية.",
        "Unauthorized": "المصادقة مطلوبة.",
        "Forbidden": "الوصول مرفوض.",
        "Failure": "حدث خطأ غير متوقع."
      }
    }
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Payments": {
    "Provider": "Mock",
    "PspAccountRef": "hani-psp-main",
    "MerchantScope": "Hani",
    "FundsHeldBy": "Hani",
    "ReturnUrlBase": "https://app.hani.ir/payments/return",
    "WebhookSecret": "hani-dev-webhook-secret"
  },
  "Commissions": {
    "DefaultRate": 0.10,
    "DefaultMinAmount": null,
    "DefaultMaxAmount": null
  },
  "Seo": {
    "PublicBaseUrl": "https://app.hani.ir"
  },
  "AllowedHosts": "*"
}
